{
  "manifest_version": 3,
  "name": "Logistaas Cost Allocation",
  "version": "1.1",
  "description": "Automate BL cost allocation and invoicing on Logistaas",
  "permissions": ["storage", "tabs", "downloads"],
  "host_permissions": ["internal-company-website/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://internal-company-website/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
